    local function isTeammate(pl)
        if not State.AimbotTeamCheck then return false end
        local lTeam = getTeamID(LP)
        local tTeam = getTeamID(pl)
        if lTeam ~= nil and tTeam ~= nil then return tostring(lTeam) == tostring(tTeam) end
