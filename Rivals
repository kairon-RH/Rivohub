local Config = {}
local function ReadConfig()
    local ok, data = pcall(function() return readfile(CONFIG_FILE) end)
    if ok and data then
        local ok2, t = pcall(function() return HttpService:JSONDecode(data) end)
        if ok2 and t then return t end
    end
    return {}
end
local function SaveConfig()
    pcall(function() writefile(CONFIG_FILE, HttpService:JSONEncode(Config)) end)
end
local function GetCfg(k, d)
    if Config[k] == nil then return d end
    return Config[k]
end
local function SetCfg(k, v)
    Config[k] = v
    SaveConfig()
end
