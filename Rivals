    local function runESP()
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl == LP then continue end
            if not pl.Character then continue end
            local hrp = pl.Character:FindFirstChild("HumanoidRootPart")
            local hum = pl.Character:FindFirstChild("Humanoid")
            if not hrp or not hum or hum.Health <= 0 then continue end

            local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
            if dist > State.ESPMaxDist then
                if espObjects[pl.UserId] then
                    for _, d in pairs(espObjects[pl.UserId]) do pcall(function() d.Visible = false end) end
                end
                continue
            end

            if not espObjects[pl.UserId] then
                espObjects[pl.UserId] = {}
                pcall(function()
                    espObjects[pl.UserId].name = Drawing.new("Text")
                    espObjects[pl.UserId].name.Size = 14
                    espObjects[pl.UserId].name.Center = true
                    espObjects[pl.UserId].name.Outline = true
                    espObjects[pl.UserId].box = Drawing.new("Square")
                    espObjects[pl.UserId].box.Filled = false
                    espObjects[pl.UserId].box.Thickness = 1.5
                    espObjects[pl.UserId].tracer = Drawing.new("Line")
                    espObjects[pl.UserId].tracer.Thickness = 1
                end)
            end

            local espColor = State.TeamColor and (pl.TeamColor and pl.TeamColor.Color or C.text) or C.accent

            pcall(function()
                local sp, onScreen = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0,2.5,0))
                if not onScreen then
                    for _, d in pairs(espObjects[pl.UserId]) do pcall(function() d.Visible = false end) end
                    return
                end
                local sf = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0,3,0))
                local h = math.abs(sp.Y - sf.Y)
                local w = h * 0.5

                if espObjects[pl.UserId].name then
                    local parts = {}
                    if State.NameESP then table.insert(parts, pl.Name) end
                    if State.HealthESP then table.insert(parts, string.format("[%d/%d]", math.floor(hum.Health), math.floor(hum.MaxHealth))) end
                    if State.DistanceESP then table.insert(parts, math.floor(dist).."m") end
                    espObjects[pl.UserId].name.Text = table.concat(parts, " ")
                    espObjects[pl.UserId].name.Position = Vector2.new(sp.X, sp.Y - h/2 - 14)
                    espObjects[pl.UserId].name.Color = espColor
                    espObjects[pl.UserId].name.Visible = State.NameESP or State.DistanceESP or State.HealthESP
                end
                if espObjects[pl.UserId].box then
                    espObjects[pl.UserId].box.Position = Vector2.new(sp.X - w/2, sp.Y - h/2)
                    espObjects[pl.UserId].box.Size = Vector2.new(w, h)
                    espObjects[pl.UserId].box.Color = espColor
                    espObjects[pl.UserId].box.Visible = State.BoxESP
