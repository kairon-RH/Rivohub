local function OpenHub()
    KeyVerified = true
    Tween(KeyWin, {BackgroundTransparency = 1}, 0.25)
    task.wait(0.3)
    KeyWin.Visible = false
    BuildHub()
end

CheckKeyBtn.MouseButton1Click:Connect(function()
    local entered = KeyInput.Text
    if entered == "" then
        KeyStatus.Text = "Enter a key."
        KeyStatus.TextColor3 = C.warning
        return
    end
    if entered == VALID_KEY then
        KeyStatus.Text = "✓ KEY VERIFIED"
        KeyStatus.TextColor3 = C.success
        Tween(CheckKeyBtn, {BackgroundColor3 = C.success}, 0.3)
        task.wait(0.7)
        OpenHub()
    else
        KeyStatus.Text = "✗ INVALID KEY — Join Discord to get yours."
        KeyStatus.TextColor3 = C.danger
        Tween(KeyInputFrame, {BackgroundColor3 = Color3.fromRGB(60, 18, 18)}, 0.1)
        task.wait(0.35)
        Tween(KeyInputFrame, {BackgroundColor3 = C.card}, 0.3)
    end
end)

KeyInput.FocusLost:Connect(function(enter)
    if enter then CheckKeyBtn.MouseButton1Click:Fire() end
end)

