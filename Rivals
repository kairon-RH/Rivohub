            local toT = hrp.Position - origin
            if toT.Magnitude > 400 then continue end
            if look:Dot(toT.Unit) > 0.6 and toT.Magnitude < bd then
                bd = toT.Magnitude; best = pl
            end
        end
        return best
    end

