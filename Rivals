    local function findTarget()
        local cam = Workspace.CurrentCamera
        if not cam then return nil end
        local vs = cam.ViewportSize
        local cx, cy = vs.X/2, vs.Y/2
        local best, bestDist = nil, math.huge
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl == LP then continue end
            if isTeammate(pl) then continue end
            if not pl.Character or not isAlive(pl.Character) then continue end
            local head = pl.Character:FindFirstChild("Head") or pl.Character:FindFirstChild("HumanoidRootPart")
            if not head then continue end
            local wDist = (cam.CFrame.Position - head.Position).Magnitude
            if wDist > State.ESPMaxDist then continue end
            if State.AimbotWallCheck then
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                rp.FilterDescendantsInstances = {pl.Character}
                local ray = Workspace:Raycast(cam.CFrame.Position, (head.Position - cam.CFrame.Position).Unit * wDist, rp)
                if ray and not ray.Instance:IsDescendantOf(pl.Character) then continue end
            end
            local sp, onScreen = cam:WorldToViewportPoint(head.Position)
            if not onScreen or sp.Z <= 0 then continue end
            local sDist = math.sqrt((sp.X-cx)^2 + (sp.Y-cy)^2)
            if sDist <= State.AimbotFOV and sDist < bestDist then
                bestDist = sDist
                best = head
            end
        end
        return best
    end

    local aimConn
    local function startAim()
        if aimConn then return end
        aimConn = AddConn(RunService.RenderStepped:Connect(function()
            if not State.AimbotEnabled then aimTarget = nil; return end
            local head = findTarget()
            if State.AimbotPersistent and not head and aimTarget and aimTarget.Parent then
                head = aimTarget
            end
            if head then
                aimTarget = head
                local cam = Workspace.CurrentCamera
                if not cam then return end
                local predicted = head.Position
                if State.AimbotPrediction then
                    local root = head.Parent and (head.Parent:FindFirstChild("HumanoidRootPart") or head.Parent:FindFirstChild("Torso"))
                    if root and root:IsA("BasePart") then
                        predicted = predicted + root.AssemblyLinearVelocity * 0.05
                    end
                end
                if not lDown then return end
                local sp = cam:WorldToViewportPoint(predicted)
                if sp.Z <= 0 then return end
                local mx = sp.X - Mouse.X
                local my = sp.Y - Mouse.Y
                local sm = math.max(1, State.AimbotSmoothing)
                aimAccX = aimAccX + mx/sm
                aimAccY = aimAccY + my/sm
                local moveX = math.floor(aimAccX)
                local moveY = math.floor(aimAccY)
                if moveX ~= 0 or moveY ~= 0 then
                    pcall(function() mousemoverel(moveX, moveY) end)
                    aimAccX = aimAccX - moveX
                    aimAccY = aimAccY - moveY
                end
            else
                aimTarget = nil
            end
            if FOVCircle then
                FOVCircle.Visible = State.DrawFOVCircle
                if State.DrawFOVCircle then
                    local cam = Workspace.CurrentCamera
                    if cam then FOVCircle.Position = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2) end
                    FOVCircle.Radius = State.AimbotFOV
                end
            end
        end))
    end
