local function Tween(obj, props, t, style, dir)
    t = t or 0.2
    style = style or Enum.EasingStyle.Quart
    dir = dir or Enum.EasingDirection.Out
    TweenService:Create(obj, TweenInfo.new(t, style, dir), props):Play()
end

local function MakeCorner(p, r) local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 8); c.Parent = p end
local function MakeStroke(p, col, th) local s = Instance.new("UIStroke"); s.Color = col or C.border; s.Thickness = th or 1; s.Parent = p; return s end
local function MakePad(p, a, t, b, l, r)
    local pad = Instance.new("UIPadding"); pad.Parent = p
    if a then pad.PaddingTop = UDim.new(0,a); pad.PaddingBottom = UDim.new(0,a); pad.PaddingLeft = UDim.new(0,a); pad.PaddingRight = UDim.new(0,a)
    else
        if t then pad.PaddingTop = UDim.new(0,t) end
        if b then pad.PaddingBottom = UDim.new(0,b) end
        if l then pad.PaddingLeft = UDim.new(0,l) end
        if r then pad.PaddingRight = UDim.new(0,r) end
    end
end

