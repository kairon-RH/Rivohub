local function MakeKeyButton(parent, text, yPos, primary)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -40, 0, 38)
    btn.Position = UDim2.new(0, 20, 0, yPos)
    btn.BackgroundColor3 = primary and C.accent or C.card
    btn.BorderSizePixel = 0
    btn.Text = text
    btn.TextColor3 = C.white
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.AutoButtonColor = false
    btn.ZIndex = 3
    btn.Parent = parent
    MakeCorner(btn, 8)
    if not primary then MakeStroke(btn, C.border, 1) end
    btn.MouseEnter:Connect(function() Tween(btn, {BackgroundColor3 = primary and C.accentHover or C.cardAlt}, 0.15) end)
    btn.MouseLeave:Connect(function() Tween(btn, {BackgroundColor3 = primary and C.accent or C.card}, 0.15) end)
    return btn
end

